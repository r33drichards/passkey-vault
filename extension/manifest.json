{
  "manifest_version": 3,
  "name": "Passkey Vault Provider (development)",
  "version": "0.1.0",
  "permissions": [
    "webAuthenticationProxy",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://passkey-vault.rwendt1337.workers.dev/provider"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
